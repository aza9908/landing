#!/usr/bin/env bash
# Управление AIRL Hub на сервере.
#   airl-hub status              какие сервисы подключены и когда было обновление
#   airl-hub set ИМЯ ЗНАЧЕНИЕ    сохранить ключ сервиса и сразу обновить данные
#   airl-hub unset ИМЯ           удалить ключ
#   airl-hub sync                обновить данные сейчас
#   airl-hub targetolog status|demo|dry|run|auto|advise|off|undo   ИИ-таргетолог
#   airl-hub agents status|run|pause|resume   ИИ-агенты: состояние / запустить сейчас / остановить и включить автозапуск
#   airl-hub kp list | allow ЛОГИН | deny ЛОГИН   кто видит агента КП (суперадмин — всегда)
#   airl-hub user list | add ЛОГИН РОЛЬ | set ЛОГИН РОЛЬ | role ЛОГИН РОЛЬ | passwd ЛОГИН | del ЛОГИН
#        set — создать, а если логин уже есть, поставить этот пароль и роль
#        роли: superadmin (разработчик), admin (руководитель), user (сотрудник, без данных 1С)
set -euo pipefail
ENVF=/etc/airl-1c-hub/env
KEYS="ODATA_URL ODATA_USER ODATA_PASS BITRIX_WEBHOOK META_ADS_TOKEN META_AD_ACCOUNT YANDEX_METRIKA_TOKEN YANDEX_METRIKA_COUNTER TELEGRAM_BOT_TOKEN TELEGRAM_CHAT ANTHROPIC_API_KEY TARGETOLOG_MODE TARGETOLOG_MAX_DAILY_BUDGET TARGETOLOG_MAX_TOTAL_DAILY TARGETOLOG_MIN_SPEND TARGETOLOG_MAX_STEP TARGETOLOG_MAX_ACTIONS AGENTS_CHAT_PER_HOUR AGENTS_MODEL AGENTS_TREND_SEARCHES AGENTS_RUN_BUDGET_USD AGENTS_TRENDS KP_MODEL KP_USD_KZT"
[ "$(id -u)" = 0 ] || { echo "Запустите от root"; exit 1; }
sync_now() { systemctl start airl-1c-hub-sync && journalctl -u airl-1c-hub-sync -n 12 --no-pager -o cat | tail -8; }
case "${1:-status}" in
  status)
    for k in $KEYS; do
      if grep -qE "^$k=.+" "$ENVF"; then echo "  [x] $k"; else echo "  [ ] $k"; fi
    done
    systemctl list-timers 'airl-1c-hub*' --no-pager 2>/dev/null | head -4 ;;
  set)
    k="${2:-}"; v="${3:-}"
    case " $KEYS " in *" $k "*) ;; *) echo "Неизвестный ключ: $k"; echo "Доступны: $KEYS"; exit 1 ;; esac
    [ -n "$v" ] || { read -r -s -p "Значение $k: " v; echo; }
    [ -n "$v" ] || { echo "Пустое значение"; exit 1; }
    case "$v" in *$'\n'*) echo "Значение должно быть в одну строку"; exit 1 ;; esac
    tmp=$(mktemp); grep -vE "^$k=" "$ENVF" > "$tmp" || true; printf '%s=%s\n' "$k" "$v" >> "$tmp"
    cat "$tmp" > "$ENVF"; rm -f "$tmp"
    echo "$k сохранён. Обновляю данные…"; sync_now ;;
  unset)
    k="${2:-}"; sed -i "/^$k=/d" "$ENVF"; echo "$k удалён"; sync_now ;;
  sync) sync_now ;;
  targetolog)
    PY=/opt/airl-1c-hub/venv/bin/python; T=/opt/airl-1c-hub/targetolog.py
    setmode() { sed -i '/^TARGETOLOG_MODE=/d' "$ENVF"; echo "TARGETOLOG_MODE=$1" >> "$ENVF"; echo "Режим таргетолога: $1"; }
    as_hub() { systemd-run --quiet --wait --pipe -p User=airl-hub -p EnvironmentFile="$ENVF" "$PY" "$T" "$@"; }
    case "${2:-status}" in
      status) echo "Режим: $(grep -E '^TARGETOLOG_MODE=' "$ENVF" | cut -d= -f2 || true)"; systemctl list-timers 'airl-hub-targetolog*' --no-pager 2>/dev/null | head -3
              journalctl -u airl-hub-targetolog -n 6 --no-pager -o cat 2>/dev/null || true ;;
      dry)    as_hub --dry ;;       # разбор без изменений в кабинете
      demo)   as_hub --demo ;;      # проба на синтетических данных, нужен только ключ Claude
      run)    as_hub ;;             # запуск сейчас в текущем режиме
      undo)   as_hub --undo ;;      # отменить действия последнего запуска
      auto|advise|off) setmode "$2" ;;
      *) echo "airl-hub targetolog status|demo|dry|run|auto|advise|off|undo" ;;
    esac ;;
  agents)
    case "${2:-status}" in
      run)    systemctl start airl-hub-agents-daily; journalctl -u airl-hub-agents-daily -n 12 --no-pager -o cat | tail -10 ;;
      status) systemctl is-active airl-hub-agents-api | sed 's/^/Чат: /'; systemctl list-timers 'airl-hub-agents*' --no-pager 2>/dev/null | head -4
              journalctl -u airl-hub-agents-daily -n 8 --no-pager -o cat 2>/dev/null || true ;;
      pause)  touch /etc/airl-1c-hub/agents-paused; systemctl disable --now airl-hub-agents-daily.timer >/dev/null 2>&1; echo "Ежедневный автозапуск агентов остановлен. Деньги тратятся только на чат и ручной запуск (airl-hub agents run)." ;;
      resume) rm -f /etc/airl-1c-hub/agents-paused; systemctl enable --now airl-hub-agents-daily.timer >/dev/null 2>&1; echo "Ежедневный автозапуск агентов включён (08:00 по Астане)." ;;
      *) echo "airl-hub agents status|run|pause|resume" ;;
    esac ;;
  user|kp)   # пользователи, роли и доступ к агенту КП — тот же код, что в разделе «Пользователи» хаба
    PY=/opt/airl-1c-hub/venv/bin/python; [ -x "$PY" ] || PY=python3
    [ -f /opt/airl-1c-hub/users.py ] || { echo "Нет /opt/airl-1c-hub/users.py — запустите обновление сервера"; exit 1; }
    # от имени службы: файлы паролей принадлежат ей, и права на них не сбиваются
    exec runuser -u airl-hub -- env HUB_NEW_PASSWORD="${HUB_NEW_PASSWORD:-}" HUB_AUTH_DIR=/etc/airl-1c-hub \
      HUB_WEB_DIR=/opt/airl-1c-hub/web HUB_DATA_DIR=/var/lib/airl-1c-hub "$PY" /opt/airl-1c-hub/users.py "$@" ;;
  *) sed -n '2,12p' "$0" ;;
esac
