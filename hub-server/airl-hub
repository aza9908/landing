#!/usr/bin/env bash
# Управление AIRL Hub на сервере.
#   airl-hub status              какие сервисы подключены и когда было обновление
#   airl-hub set ИМЯ ЗНАЧЕНИЕ    сохранить ключ сервиса и сразу обновить данные
#   airl-hub unset ИМЯ           удалить ключ
#   airl-hub sync                обновить данные сейчас
#   airl-hub targetolog status|demo|dry|run|auto|advise|off|undo   ИИ-таргетолог
#   airl-hub agents status|run|pause|resume   ИИ-агенты: состояние / запустить сейчас / остановить и включить автозапуск
#   airl-hub user list | add ЛОГИН РОЛЬ | role ЛОГИН РОЛЬ | passwd ЛОГИН | del ЛОГИН
#        роли: superadmin (разработчик), admin (руководитель), user (сотрудник, без данных 1С)
set -euo pipefail
ENVF=/etc/airl-1c-hub/env
KEYS="ODATA_URL ODATA_USER ODATA_PASS BITRIX_WEBHOOK META_ADS_TOKEN META_AD_ACCOUNT YANDEX_METRIKA_TOKEN YANDEX_METRIKA_COUNTER TELEGRAM_BOT_TOKEN TELEGRAM_CHAT ANTHROPIC_API_KEY TARGETOLOG_MODE TARGETOLOG_MAX_DAILY_BUDGET TARGETOLOG_MAX_TOTAL_DAILY TARGETOLOG_MIN_SPEND TARGETOLOG_MAX_STEP TARGETOLOG_MAX_ACTIONS AGENTS_CHAT_PER_HOUR AGENTS_MODEL AGENTS_TREND_SEARCHES AGENTS_RUN_BUDGET_USD AGENTS_TRENDS"
[ "$(id -u)" = 0 ] || { echo "Запустите от root"; exit 1; }
sync_now() { systemctl start airl-1c-hub-sync && journalctl -u airl-1c-hub-sync -n 12 --no-pager -o cat | tail -8; }
case "${1:-status}" in
  status)
    for k in $KEYS; do
      if grep -qE "^$k=.+" "$ENVF"; then echo "  [x] $k"; else echo "  [ ] $k"; fi
    done
    systemctl list-timers 'airl-1c-hub*' --no-pager 2>/dev/null | head -4 ;;
  set)
    k="${2:-}"; v="${3:-}"
    case " $KEYS " in *" $k "*) ;; *) echo "Неизвестный ключ: $k"; echo "Доступны: $KEYS"; exit 1 ;; esac
    [ -n "$v" ] || { read -r -s -p "Значение $k: " v; echo; }
    [ -n "$v" ] || { echo "Пустое значение"; exit 1; }
    case "$v" in *$'\n'*) echo "Значение должно быть в одну строку"; exit 1 ;; esac
    tmp=$(mktemp); grep -vE "^$k=" "$ENVF" > "$tmp" || true; printf '%s=%s\n' "$k" "$v" >> "$tmp"
    cat "$tmp" > "$ENVF"; rm -f "$tmp"
    echo "$k сохранён. Обновляю данные…"; sync_now ;;
  unset)
    k="${2:-}"; sed -i "/^$k=/d" "$ENVF"; echo "$k удалён"; sync_now ;;
  sync) sync_now ;;
  targetolog)
    PY=/opt/airl-1c-hub/venv/bin/python; T=/opt/airl-1c-hub/targetolog.py
    setmode() { sed -i '/^TARGETOLOG_MODE=/d' "$ENVF"; echo "TARGETOLOG_MODE=$1" >> "$ENVF"; echo "Режим таргетолога: $1"; }
    as_hub() { systemd-run --quiet --wait --pipe -p User=airl-hub -p EnvironmentFile="$ENVF" "$PY" "$T" "$@"; }
    case "${2:-status}" in
      status) echo "Режим: $(grep -E '^TARGETOLOG_MODE=' "$ENVF" | cut -d= -f2 || true)"; systemctl list-timers 'airl-hub-targetolog*' --no-pager 2>/dev/null | head -3
              journalctl -u airl-hub-targetolog -n 6 --no-pager -o cat 2>/dev/null || true ;;
      dry)    as_hub --dry ;;       # разбор без изменений в кабинете
      demo)   as_hub --demo ;;      # проба на синтетических данных, нужен только ключ Claude
      run)    as_hub ;;             # запуск сейчас в текущем режиме
      undo)   as_hub --undo ;;      # отменить действия последнего запуска
      auto|advise|off) setmode "$2" ;;
      *) echo "airl-hub targetolog status|demo|dry|run|auto|advise|off|undo" ;;
    esac ;;
  agents)
    case "${2:-status}" in
      run)    systemctl start airl-hub-agents-daily; journalctl -u airl-hub-agents-daily -n 12 --no-pager -o cat | tail -10 ;;
      status) systemctl is-active airl-hub-agents-api | sed 's/^/Чат: /'; systemctl list-timers 'airl-hub-agents*' --no-pager 2>/dev/null | head -4
              journalctl -u airl-hub-agents-daily -n 8 --no-pager -o cat 2>/dev/null || true ;;
      pause)  systemctl disable --now airl-hub-agents-daily.timer >/dev/null 2>&1; echo "Ежедневный автозапуск агентов остановлен. Деньги тратятся только на чат и ручной запуск (airl-hub agents run)." ;;
      resume) systemctl enable --now airl-hub-agents-daily.timer >/dev/null 2>&1; echo "Ежедневный автозапуск агентов включён (08:00 по Астане)." ;;
      *) echo "airl-hub agents status|run|pause|resume" ;;
    esac ;;
  user)
    C=/etc/airl-1c-hub; ROLES=$C/roles; ALL=$C/htpasswd; ADM=$C/htpasswd-admin; PRIV=/opt/airl-1c-hub/web/private
    touch "$ROLES" "$ALL"
    role_ok() { case "$1" in superadmin|admin|user) ;; *) echo "Роль должна быть superadmin, admin или user"; exit 1 ;; esac; }
    name_ok() { echo "$1" | grep -qE '^[a-z0-9][a-z0-9._-]{1,30}$' || { echo "Логин: латинские буквы, цифры, . _ - (от 2 знаков)"; exit 1; }; }
    has() { grep -qE "^$1:" "$ALL"; }
    ask_pass() { local a b; read -r -s -p "Пароль для $1: " a; echo >&2; read -r -s -p "Ещё раз: " b; echo >&2
                 [ -n "$a" ] && [ "$a" = "$b" ] || { echo "Пароли пустые или не совпали" >&2; exit 1; }
                 printf '%s' "$a"; }
    pw_ok() { [ ${#1} -ge 8 ] || { echo "Пароль должен быть не короче 8 знаков"; exit 1; }; }
    rebuild() {   # htpasswd-admin и roles.json собираются из списка ролей
      local lu lr sep
      : > "$ADM.tmp"
      while IFS=: read -r lu lr; do
        case "$lr" in superadmin|admin) grep -E "^$lu:" "$ALL" >> "$ADM.tmp" || true ;; esac
      done < "$ROLES"
      mv "$ADM.tmp" "$ADM"
      for f in "$ALL" "$ADM"; do chown root:www-data "$f" 2>/dev/null || chown root:nginx "$f" 2>/dev/null || true; chmod 640 "$f"; done
      chmod 600 "$ROLES"
      install -d -o airl-hub -g airl-hub -m 755 "$PRIV"
      { printf '{'; sep=''; while IFS=: read -r lu lr; do printf '%s"%s":"%s"' "$sep" "$lu" "$lr"; sep=','; done < "$ROLES"; printf '}\n'; } > "$PRIV/roles.json"
      chown airl-hub: "$PRIV/roles.json"
    }
    set_role() { sed -i "/^$1:/d" "$ROLES"; echo "$1:$2" >> "$ROLES"; }
    admins_left() { grep -cE ':(superadmin|admin)$' "$ROLES" || true; }
    case "${2:-list}" in
      list) printf '%-20s %s\n' ЛОГИН РОЛЬ; while IFS=: read -r lu _; do printf '%-20s %s\n' "$lu" "$(grep -E "^$lu:" "$ROLES" | cut -d: -f2 || true)"; done < "$ALL" ;;
      add)  u="${3:-}"; r="${4:-user}"; name_ok "$u"; role_ok "$r"; has "$u" && { echo "Пользователь $u уже есть (смена роли: airl-hub user role $u РОЛЬ)"; exit 1; }
            pw="${HUB_NEW_PASSWORD:-}"; [ -n "$pw" ] || pw="$(ask_pass "$u")"; pw_ok "$pw"
            printf '%s:%s\n' "$u" "$(openssl passwd -apr1 "$pw")" >> "$ALL"; set_role "$u" "$r"; rebuild; echo "Добавлен $u с ролью $r" ;;
      role) u="${3:-}"; r="${4:-}"; role_ok "$r"; has "$u" || { echo "Нет пользователя $u"; exit 1; }
            old=$(grep -E "^$u:" "$ROLES" | cut -d: -f2 || true); set_role "$u" "$r"
            [ "$(admins_left)" -ge 1 ] || { set_role "$u" "$old"; echo "Нельзя: не останется ни одного руководителя"; exit 1; }
            rebuild; echo "$u теперь $r" ;;
      passwd) u="${3:-}"; has "$u" || { echo "Нет пользователя $u"; exit 1; }
            pw="${HUB_NEW_PASSWORD:-}"; [ -n "$pw" ] || pw="$(ask_pass "$u")"; pw_ok "$pw"
            sed -i "/^$u:/d" "$ALL"; printf '%s:%s\n' "$u" "$(openssl passwd -apr1 "$pw")" >> "$ALL"; rebuild; echo "Пароль $u изменён" ;;
      del)  u="${3:-}"; has "$u" || { echo "Нет пользователя $u"; exit 1; }
            cp "$ROLES" "$ROLES.bak"; sed -i "/^$u:/d" "$ROLES"
            [ "$(admins_left)" -ge 1 ] || { mv "$ROLES.bak" "$ROLES"; echo "Нельзя: не останется ни одного руководителя"; exit 1; }
            rm -f "$ROLES.bak"; sed -i "/^$u:/d" "$ALL"; rebuild; echo "Удалён $u" ;;
      rebuild) rebuild ;;
      *) echo "airl-hub user list | add ЛОГИН РОЛЬ | role ЛОГИН РОЛЬ | passwd ЛОГИН | del ЛОГИН" ;;
    esac ;;
  *) sed -n '2,10p' "$0" ;;
esac
