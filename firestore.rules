rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Поля «откуда пришёл» (airl-attr.js): строки до 100 символов.
    function attributionOk() {
      return request.resource.data.get('utm_source', '').size() <= 100
          && request.resource.data.get('utm_medium', '').size() <= 100
          && request.resource.data.get('utm_campaign', '').size() <= 100
          && request.resource.data.get('referrer', '').size() <= 100
          && request.resource.data.get('landing', '').size() <= 100;
    }

    // Заявки с сайта: посетители могут только создавать,
    // читать — только вы через консоль Firebase
    match /requests/{doc} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    // Внутренние задачи (доска «Задачи»)
    match /tasks/{doc} {
      allow read, write: if true;
    }

    // Заявки с формы «Оставить заявку» (агент диагностики): писать может
    // любой, читать из браузера — никто.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['company','name','phone','team_size','wish','source','status','created_at',
                          'utm_source','utm_medium','utm_campaign','referrer','landing'])
                    && request.resource.data.company is string
                    && request.resource.data.company.size() >= 2
                    && request.resource.data.company.size() <= 120
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 40
                    && request.resource.data.get('wish', '').size() <= 500
                    && attributionOk();
      allow read, update, delete: if false;
    }

    // Результаты экспресс-диагностики (/diagnostics): писать может любой,
    // читать — только Cloud Function статистики (leadStats) с паролем панели.
    match /express_diagnostics/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['name','company','position','industry','team_size','contact',
                          'q1','q2','q3','q4','q5','q6','q7','q8','group_code',
                          'score','level','priority','segment','tier','heat','icp','trigger',
                          'report_markdown','source','status','created_at','bot',
                          'utm_source','utm_medium','utm_campaign','referrer','landing'])
                    && request.resource.data.bot == 'express-diagnostics'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.company is string
                    && request.resource.data.company.size() <= 120
                    && request.resource.data.score is int
                    && request.resource.data.score >= 4
                    && request.resource.data.score <= 16
                    && request.resource.data.get('contact', '').size() <= 80
                    && request.resource.data.get('report_markdown', '').size() <= 30000
                    && attributionOk();
      allow read, update, delete: if false;
    }

    // Витрина кода группы: страница диагностики проверяет по ней код.
    match /groups_public/{code} {
      allow read: if true;
      allow write: if false;
    }

    // Сами группы, ответы сотрудников и чат-сессии диагностики: доступ
    // только через Cloud Functions (Admin SDK её не спрашивает, но
    // явный запрет закрывает путь для прямых запросов из браузера,
    // раз анкета больше не пишет в Firestore сама — только через
    // проверенный и ограниченный по частоте эндпойнт /interview).
    match /groups/{code} {
      allow read, write: if false;

      match /responses/{responseId} {
        allow read, write: if false;
      }
      match /chat_sessions/{sessionId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
